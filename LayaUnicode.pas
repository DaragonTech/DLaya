(* ---- Lookups ---- *)

function InRanges(const Ranges: array of Integer; Count, C: Integer): Boolean;
var
  Lo, Hi, Mid: Integer;
begin
  Result := False;
  Lo := 0;
  Hi := Count - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    if C < Ranges[Mid * 2] then
      Hi := Mid - 1
    else if C > Ranges[Mid * 2 + 1] then
      Lo := Mid + 1
    else
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function LayaIsLetter(C: Integer): Boolean;
begin
  if C < $80 then
    Result := ((C >= $41) and (C <= $5A)) or ((C >= $61) and (C <= $7A))
  else
    Result := InRanges(LetterRanges, LetterRangeCount, C);
end;

function LayaIsNumber(C: Integer): Boolean;
begin
  if C < $80 then
    Result := (C >= $30) and (C <= $39)
  else
    Result := InRanges(NumberRanges, NumberRangeCount, C);
end;

function LayaIsWhiteSpace(C: Integer): Boolean;
begin
  if C < $80 then
    Result := (C = $20) or ((C >= $09) and (C <= $0D))
  else
    Result := InRanges(SpaceRanges, SpaceRangeCount, C);
end;

function LayaCombiningClass(C: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := 0;
  if C < $300 then
    Exit;
  Lo := 0;
  Hi := CombiningRangeCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    if C < CombiningRanges[Mid * 3] then
      Hi := Mid - 1
    else if C > CombiningRanges[Mid * 3 + 1] then
      Lo := Mid + 1
    else
    begin
      Result := CombiningRanges[Mid * 3 + 2];
      Exit;
    end;
  end;
end;

(* Index of the decomposition of C in Decompositions, or -1. *)
function FindDecomposition(C: Integer): Integer;
var
  Lo, Hi, Mid, V: Integer;
begin
  Result := -1;
  Lo := 0;
  Hi := DecompositionCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    V := Decompositions[Mid * 3];
    if C < V then
      Hi := Mid - 1
    else if C > V then
      Lo := Mid + 1
    else
    begin
      Result := Mid * 3;
      Exit;
    end;
  end;
end;

(* The character that A followed by B composes to, or -1. *)
function ComposePair(A, B: Integer): Integer;
var
  Lo, Hi, Mid, VA, VB: Integer;
begin
  Result := -1;
  (* Hangul: leading consonant + vowel, then that syllable + trailing consonant. *)
  if (A >= HangulLBase) and (A < HangulLBase + HangulLCount) then
  begin
    if (B >= HangulVBase) and (B < HangulVBase + HangulVCount) then
      Result := HangulSBase + ((A - HangulLBase) * HangulVCount + (B - HangulVBase)) * HangulTCount;
    Exit;
  end;
  if (A >= HangulSBase) and (A < HangulSBase + HangulSCount) then
  begin
    if ((A - HangulSBase) mod HangulTCount = 0) and (B > HangulTBase) and
       (B < HangulTBase + HangulTCount) then
      Result := A + (B - HangulTBase);
    Exit;
  end;
  Lo := 0;
  Hi := CompositionCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    VA := Compositions[Mid * 3];
    VB := Compositions[Mid * 3 + 1];
    if (A < VA) or ((A = VA) and (B < VB)) then
      Hi := Mid - 1
    else if (A > VA) or (B > VB) then
      Lo := Mid + 1
    else
    begin
      Result := Compositions[Mid * 3 + 2];
      Exit;
    end;
  end;
end;

(* ---- Conversions ---- *)

function LayaStringToCodePoints(const S: string): TLayaCodePoints;
var
  I, N, Count, C, D: Integer;
begin
  Result := nil;
  N := Length(S);
  SetLength(Result, N);
  Count := 0;
  I := 1;
  while I <= N do
  begin
    C := Ord(S[I]);
    Inc(I);
    if (C >= $D800) and (C <= $DBFF) then
    begin
      if I <= N then D := Ord(S[I]) else D := 0;
      if (D >= $DC00) and (D <= $DFFF) then
      begin
        C := $10000 + ((C - $D800) shl 10) + (D - $DC00);
        Inc(I);
      end
      else
        C := $FFFD;
    end
    else if (C >= $DC00) and (C <= $DFFF) then
      C := $FFFD;
    Result[Count] := C;
    Inc(Count);
  end;
  SetLength(Result, Count);
end;

function LayaCodePointsToString(const A: TLayaCodePoints): string;
var
  I, N, C: Integer;
begin
  N := 0;
  for I := 0 to High(A) do
    if A[I] >= $10000 then Inc(N, 2) else Inc(N);
  SetLength(Result, N);
  N := 1;
  for I := 0 to High(A) do
  begin
    C := A[I];
    if C >= $10000 then
    begin
      C := C - $10000;
      Result[N] := Char($D800 + (C shr 10));
      Result[N + 1] := Char($DC00 + (C and $3FF));
      Inc(N, 2);
    end
    else
    begin
      Result[N] := Char(C);
      Inc(N);
    end;
  end;
end;

function LayaUtf8ToCodePoints(const B: TBytes): TLayaCodePoints;
var
  I, N, Count, C, Need, Min, K: Integer;
  Ok: Boolean;
begin
  Result := nil;
  N := Length(B);
  SetLength(Result, N);
  Count := 0;
  I := 0;
  while I < N do
  begin
    C := B[I];
    Inc(I);
    if C >= $80 then
    begin
      if (C and $E0) = $C0 then begin Need := 1; Min := $80; C := C and $1F; end
      else if (C and $F0) = $E0 then begin Need := 2; Min := $800; C := C and $0F; end
      else if (C and $F8) = $F0 then begin Need := 3; Min := $10000; C := C and $07; end
      else begin Need := 0; Min := 0; C := -1; end;
      Ok := (C >= 0) and (I + Need <= N);
      if Ok then
        for K := 0 to Need - 1 do
          if (B[I + K] and $C0) <> $80 then
          begin
            Ok := False;
            Break;
          end;
      if Ok then
      begin
        for K := 0 to Need - 1 do
          C := (C shl 6) or (B[I + K] and $3F);
        if (C < Min) or (C > $10FFFF) or ((C >= $D800) and (C <= $DFFF)) then
          Ok := False
        else
          Inc(I, Need);
      end;
      if not Ok then
        C := $FFFD;
    end;
    Result[Count] := C;
    Inc(Count);
  end;
  SetLength(Result, Count);
end;

function LayaCodePointsToUtf8(const A: TLayaCodePoints): TBytes;
var
  I, N, C: Integer;
begin
  Result := nil;
  N := 0;
  for I := 0 to High(A) do
  begin
    C := A[I];
    if C < $80 then Inc(N)
    else if C < $800 then Inc(N, 2)
    else if C < $10000 then Inc(N, 3)
    else Inc(N, 4);
  end;
  SetLength(Result, N);
  N := 0;
  for I := 0 to High(A) do
  begin
    C := A[I];
    if C < $80 then
    begin
      Result[N] := C;
      Inc(N);
    end
    else if C < $800 then
    begin
      Result[N] := $C0 or (C shr 6);
      Result[N + 1] := $80 or (C and $3F);
      Inc(N, 2);
    end
    else if C < $10000 then
    begin
      Result[N] := $E0 or (C shr 12);
      Result[N + 1] := $80 or ((C shr 6) and $3F);
      Result[N + 2] := $80 or (C and $3F);
      Inc(N, 3);
    end
    else
    begin
      Result[N] := $F0 or (C shr 18);
      Result[N + 1] := $80 or ((C shr 12) and $3F);
      Result[N + 2] := $80 or ((C shr 6) and $3F);
      Result[N + 3] := $80 or (C and $3F);
      Inc(N, 4);
    end;
  end;
end;

function LayaUtf8ToString(const B: TBytes): string;
begin
  Result := LayaCodePointsToString(LayaUtf8ToCodePoints(B));
end;

function LayaStringToUtf8(const S: string): TBytes;
begin
  Result := LayaCodePointsToUtf8(LayaStringToCodePoints(S));
end;

(* ---- Normalization form C ---- *)

type
  TBuffer = record
    Items: TLayaCodePoints;
    Count: Integer;
  end;

procedure Append(var Buffer: TBuffer; C: Integer);
begin
  if Buffer.Count = Length(Buffer.Items) then
    SetLength(Buffer.Items, Buffer.Count * 2 + 16);
  Buffer.Items[Buffer.Count] := C;
  Inc(Buffer.Count);
end;

(* Full canonical decomposition of one character. *)
procedure Decompose(C: Integer; var Buffer: TBuffer);
var
  At, S, T: Integer;
begin
  if C < $C0 then
  begin
    Append(Buffer, C);
    Exit;
  end;
  if (C >= HangulSBase) and (C < HangulSBase + HangulSCount) then
  begin
    S := C - HangulSBase;
    Append(Buffer, HangulLBase + S div HangulNCount);
    Append(Buffer, HangulVBase + (S mod HangulNCount) div HangulTCount);
    T := S mod HangulTCount;
    if T <> 0 then
      Append(Buffer, HangulTBase + T);
    Exit;
  end;
  At := FindDecomposition(C);
  if At < 0 then
  begin
    Append(Buffer, C);
    Exit;
  end;
  Decompose(Decompositions[At + 1], Buffer);
  if Decompositions[At + 2] <> 0 then
    Decompose(Decompositions[At + 2], Buffer);
end;

function LayaNFC(const A: TLayaCodePoints): TLayaCodePoints;
var
  Buffer: TBuffer;
  Ccc: array of Integer;
  I, J, N, C, K, Tmp: Integer;
  StarterPos, Starter, LastClass, Composite, OutCount: Integer;
  Plain: Boolean;
begin
  (* Nothing below U+0300 changes under NFC unless a combining character follows it, and
    every combining character is at U+0300 or above. Most text ends here. *)
  Plain := True;
  for I := 0 to High(A) do
    if A[I] >= $300 then
    begin
      Plain := False;
      Break;
    end;
  if Plain then
  begin
    Result := A;
    Exit;
  end;

  (* 1. Decompose. *)
  Buffer.Count := 0;
  SetLength(Buffer.Items, Length(A) + 16);
  for I := 0 to High(A) do
    Decompose(A[I], Buffer);
  N := Buffer.Count;

  (* 2. Put combining characters into canonical order. *)
  SetLength(Ccc, N);
  for I := 0 to N - 1 do
    Ccc[I] := LayaCombiningClass(Buffer.Items[I]);
  for I := 1 to N - 1 do
  begin
    K := Ccc[I];
    if K = 0 then
      Continue;
    J := I;
    while (J > 0) and (Ccc[J - 1] > K) do
    begin
      Tmp := Buffer.Items[J - 1];
      Buffer.Items[J - 1] := Buffer.Items[J];
      Buffer.Items[J] := Tmp;
      Ccc[J] := Ccc[J - 1];
      Ccc[J - 1] := K;
      Dec(J);
    end;
  end;

  (* 3. Compose. *)
  if N = 0 then
  begin
    Result := nil;
    Exit;
  end;
  StarterPos := 0;
  Starter := Buffer.Items[0];
  LastClass := Ccc[0];
  if LastClass <> 0 then
    LastClass := 256;   (* a text that starts with a combining character: nothing composes with it *)
  OutCount := 1;
  for I := 1 to N - 1 do
  begin
    C := Buffer.Items[I];
    K := Ccc[I];
    if (LastClass < K) or (LastClass = 0) then
      Composite := ComposePair(Starter, C)
    else
      Composite := -1;
    if Composite >= 0 then
    begin
      Buffer.Items[StarterPos] := Composite;
      Starter := Composite;
    end
    else
    begin
      if K = 0 then
      begin
        StarterPos := OutCount;
        Starter := C;
      end;
      LastClass := K;
      Buffer.Items[OutCount] := C;
      Inc(OutCount);
    end;
  end;
  SetLength(Buffer.Items, OutCount);
  Result := Buffer.Items;
end;

function LayaNormalizeNFC(const S: string): string;
var
  I: Integer;
  Plain: Boolean;
begin
  Plain := True;
  for I := 1 to Length(S) do
    if Ord(S[I]) >= $300 then
    begin
      Plain := False;
      Break;
    end;
  if Plain then
    Result := S
  else
    Result := LayaCodePointsToString(LayaNFC(LayaStringToCodePoints(S)));
end;

end.
