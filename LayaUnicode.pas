unit LayaUnicode;

(* Unicode data and functions for LayaTokenizer.pas.

  The Laya engine inside LibLayaX classifies and normalizes text with ICU. To count tokens the
  way the engine does, the tokenizer must make the same decisions for every character: what is
  a letter, a number or white space, and what a text looks like after NFC normalization. This
  unit holds that data, so the tokenizer needs no regular expression library and no call to the
  operating system, and gives the same result on every platform and with every compiler.

  The tables were generated from ICU 76.1 (Unicode 16.0), the version built into the released
  LibLayaX libraries. Do not edit them by hand.

  Code points are plain Integer values (0..$10FFFF).

  The tables derive from the Unicode Character Database, Copyright (c) Unicode, Inc., used
  under the Unicode License V3. See NOTICE. *)

{$IFDEF FPC}{$MODE DELPHIUNICODE}{$CODEPAGE UTF8}{$ENDIF}
{$IFNDEF FPC}{$IF CompilerVersion >= 24}{$ZEROBASEDSTRINGS OFF}{$IFEND}{$ENDIF}
{$Q-}{$R-}

interface

uses
  SysUtils;

const
  LayaUnicodeVersion = '16.0';

type
  TLayaCodePoints = array of Integer;

(* Character classes, as the engine's pre-tokenizer sees them. *)
function LayaIsLetter(C: Integer): Boolean;       (* \p{L} *)
function LayaIsNumber(C: Integer): Boolean;       (* \p{N} *)
function LayaIsWhiteSpace(C: Integer): Boolean;   (* \s, which in the engine is White_Space *)

(* Canonical combining class, 0 for most characters. *)
function LayaCombiningClass(C: Integer): Integer;

(* Text to code points and back. A surrogate without its pair becomes U+FFFD. *)
function LayaStringToCodePoints(const S: string): TLayaCodePoints;
function LayaCodePointsToString(const A: TLayaCodePoints): string;

(* UTF-8 bytes to code points and back. Bytes that are not valid UTF-8 become U+FFFD. *)
function LayaUtf8ToCodePoints(const B: TBytes): TLayaCodePoints;
function LayaCodePointsToUtf8(const A: TLayaCodePoints): TBytes;
function LayaUtf8ToString(const B: TBytes): string;
function LayaStringToUtf8(const S: string): TBytes;

(* Unicode normalization form C. A text that needs no change is returned as it is, not as
  a copy. *)
function LayaNFC(const A: TLayaCodePoints): TLayaCodePoints;
function LayaNormalizeNFC(const S: string): string;

implementation

